<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>PlaySphere.Worker</RootNamespace>
    <Description>Background conversion/clip-export queue (PICKLE.md A 130). Depends on Domain + Application + the Media.Export/Probe modules; runs heavy ffmpeg jobs serially below normal priority so playback is never starved.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PlaySphere.Domain\PlaySphere.Domain.csproj" />
    <ProjectReference Include="..\PlaySphere.Application\PlaySphere.Application.csproj" />
    <ProjectReference Include="..\PlaySphere.Media.Export\PlaySphere.Media.Export.csproj" />
    <ProjectReference Include="..\PlaySphere.Media.Probe\PlaySphere.Media.Probe.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PlaySphere.IntegrationTests" />
  </ItemGroup>

</Project>