<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>PlaySphere.AI</RootNamespace>
    <UseWinUI>false</UseWinUI>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Description>OpenAI service boundary and implementation (PICKLE.md §38-§41). All OpenAI access lives here behind IAiMediaService; API key in Windows secure credential storage. Depends on Domain + Application only.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PlaySphere.Domain\PlaySphere.Domain.csproj" />
    <ProjectReference Include="..\PlaySphere.Application\PlaySphere.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PlaySphere.UnitTests" />
  </ItemGroup>

</Project>
