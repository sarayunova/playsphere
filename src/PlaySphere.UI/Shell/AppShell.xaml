<Page
    x:Class="PlaySphere.UI.Shell.AppShell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PlaySphere.UI.Controls">

    <NavigationView
        x:Name="RootNavigation"
        Background="{ThemeResource BrushBackgroundPrimary}"
        PaneDisplayMode="Left"
        OpenPaneLength="220"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        IsPaneToggleButtonVisible="False"
        SelectionFollowsFocus="Disabled"
        SelectionChanged="RootNavigation_SelectionChanged">

        <NavigationView.Resources>
            <SolidColorBrush x:Key="NavigationViewPaneBackground" Color="{StaticResource ColorBackgroundSecondary}" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="{StaticResource ColorBackgroundSecondary}" />
        </NavigationView.Resources>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Frame x:Name="ContentFrame" Grid.Row="0" />

            <!-- Shell-owned, app-lifetime video render surface (ADR-0012). PlayerPage borrows this
                 single VideoSurfaceHost instance instead of constructing its own, so ordinary
                 navigation away from and back to the player never creates a new native swap-chain
                 and therefore never forces a renderer rebuild (see AttachVideoSurfaceAsync's
                 swap-chain-options-equal no-op path). Parked here (zero-size, non-hit-testable)
                 whenever PlayerPage isn't the current view. -->
            <Grid
                x:Name="VideoHostParkingSpot"
                Grid.Row="0"
                Width="0"
                Height="0"
                Opacity="0"
                IsHitTestVisible="False"
                HorizontalAlignment="Left"
                VerticalAlignment="Top">
                <controls:VideoSurfaceHost x:Name="SharedVideoHost" />
            </Grid>

            <!-- Persistent "now playing" bar: shown whenever media is loaded in the (singleton,
                 always-live) playback engine but the player page itself isn't the current view, so
                 background playback started elsewhere is never orphaned with no way back to it. -->
            <Grid
                x:Name="NowPlayingBar"
                Grid.Row="1"
                Visibility="Collapsed"
                Background="{ThemeResource BrushSurfaceCard}"
                BorderBrush="{ThemeResource BrushBorderSubtle}"
                BorderThickness="0,1,0,0"
                Padding="16,10"
                ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    Orientation="Horizontal"
                    Spacing="10"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    Tapped="NowPlayingBar_Tapped">
                    <TextBlock
                        Text="Now Playing:"
                        Foreground="{ThemeResource BrushTextSecondary}"
                        FontSize="13"
                        VerticalAlignment="Center" />
                    <TextBlock
                        x:Name="NowPlayingTitle"
                        Foreground="{ThemeResource BrushTextPrimary}"
                        FontSize="13"
                        FontWeight="SemiBold"
                        TextTrimming="CharacterEllipsis"
                        VerticalAlignment="Center" />
                </StackPanel>

                <Button
                    x:Name="NowPlayingPlayPauseButton"
                    Grid.Column="1"
                    Click="NowPlayingPlayPauseButton_Click"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="8"
                    VerticalAlignment="Center"
                    ToolTipService.ToolTip="Play/Pause">
                    <FontIcon x:Name="NowPlayingPlayPauseIcon" FontSize="14" />
                </Button>
            </Grid>
        </Grid>
    </NavigationView>

</Page>