<Page
    x:Class="PlaySphere.UI.Pages.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource BrushBackgroundPrimary}"
    Loaded="Page_Loaded">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="28" Spacing="{ThemeResource SpacingMedium}">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Style="{ThemeResource PageTitleTextStyle}" Text="Library" />
                    <TextBlock
                        Style="{ThemeResource SecondaryTextStyle}"
                        Text="Your media collection — videos, music, folders, favorites and continue-watching."
                        TextWrapping="Wrap" />
                </StackPanel>
                <Button
                    x:Name="AddFolderButton"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Padding="18,10"
                    Background="{ThemeResource GradientAccentPrimary}"
                    Foreground="White"
                    CornerRadius="8"
                    FontWeight="SemiBold"
                    Click="AddFolderButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8B7;" FontSize="16" />
                        <TextBlock Text="Add Folder" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Library Folders -->
            <StackPanel x:Name="FoldersSection" Spacing="8" Visibility="Collapsed">
                <TextBlock Style="{ThemeResource SectionHeaderTextStyle}" Text="Folders" />
                <StackPanel x:Name="FoldersList" Spacing="8" />
            </StackPanel>

            <!-- Scan status -->
            <StackPanel x:Name="ScanStatusPanel" Orientation="Horizontal" Spacing="10" Visibility="Collapsed">
                <ProgressRing x:Name="ScanProgressRing" Width="18" Height="18" IsActive="True" />
                <TextBlock x:Name="ScanStatusText" Style="{ThemeResource MutedTextStyle}" Text="Scanning…" />
            </StackPanel>

            <!-- Search -->
            <TextBox
                x:Name="LibrarySearchBox"
                PlaceholderText="Search your library..."
                Visibility="Collapsed"
                TextChanged="LibrarySearchBox_TextChanged" />

            <!-- Empty state (no folders added yet) -->
            <Border x:Name="EmptyStateCard" Style="{ThemeResource EmptyStateCardStyle}" Margin="0,12,0,0">
                <StackPanel Spacing="8" VerticalAlignment="Center">
                    <TextBlock Style="{ThemeResource SectionHeaderTextStyle}" Text="No library yet" />
                    <TextBlock
                        Style="{ThemeResource MutedTextStyle}"
                        Text="Add a folder to start cataloging your videos and music. PlaySphere never scans your drives automatically — you choose every folder."
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Media items -->
            <StackPanel x:Name="MediaItemsSection" Spacing="8" Visibility="Collapsed">
                <TextBlock x:Name="MediaItemsHeader" Style="{ThemeResource SectionHeaderTextStyle}" Text="All Media" />
                <VariableSizedWrapGrid
                    x:Name="MediaItemsList"
                    Orientation="Horizontal"
                    HorizontalChildrenAlignment="Left" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>

</Page>
