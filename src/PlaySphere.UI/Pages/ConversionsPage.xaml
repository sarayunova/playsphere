<Page
    x:Class="PlaySphere.UI.Pages.ConversionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PlaySphere.UI.Pages"
    Background="{ThemeResource BrushBackgroundPrimary}"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="28" Spacing="{ThemeResource SpacingMedium}">
            <TextBlock Style="{ThemeResource PageTitleTextStyle}" Text="Conversions" />
            <TextBlock
                Style="{ThemeResource SecondaryTextStyle}"
                Text="Background conversion and clip-export jobs. Jobs run one at a time below normal priority so playback is never interrupted. Cancel, retry and open the output folder from each job."
                TextWrapping="Wrap" />

            <ListView
                x:Name="JobsList"
                SelectionMode="None"
                ItemsSource="{x:Bind Jobs}">
                <ListView.Header>
                    <TextBlock
                        Style="{ThemeResource SectionHeaderTextStyle}"
                        Text="Jobs"
                        Margin="0,8,0,0" />
                </ListView.Header>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:ConversionJobRow">
                        <Border
                            Padding="14"
                            Margin="0,4"
                            CornerRadius="{ThemeResource ControlCornerRadius}"
                            Background="{ThemeResource BrushSurfaceCard}">
                            <Grid ColumnSpacing="14" RowSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                                    <TextBlock
                                        Text="{x:Bind Label}"
                                        FontSize="14"
                                        FontWeight="SemiBold" />
                                    <TextBlock
                                        Text="{x:Bind InputPath}"
                                        Style="{ThemeResource SecondaryTextStyle}"
                                        FontSize="12"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Text="{x:Bind OutputPath}"
                                        Style="{ThemeResource SecondaryTextStyle}"
                                        FontSize="12"
                                        TextTrimming="CharacterEllipsis"
                                        Foreground="{ThemeResource BrushAccentBlue}" />
                                </StackPanel>

                                <TextBlock
                                    Grid.Row="0" Grid.Column="1"
                                    Text="{x:Bind StatusText}"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{x:Bind StatusBrush}"
                                    VerticalAlignment="Top" />

                                <ProgressBar
                                    Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                    Maximum="100"
                                    Value="{x:Bind ProgressPercent}"
                                    Visibility="{x:Bind ShowProgress}" />

                                <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        Content="Cancel"
                                        FontSize="12"
                                        Padding="10,4"
                                        Visibility="{x:Bind ShowCancel}"
                                        Tag="{x:Bind Id}"
                                        Click="CancelButton_Click" />
                                    <Button
                                        Grid.Column="1"
                                        Content="Retry"
                                        FontSize="12"
                                        Padding="10,4"
                                        Visibility="{x:Bind ShowRetry}"
                                        Tag="{x:Bind Id}"
                                        Click="RetryButton_Click" />
                                    <Button
                                        Grid.Column="2"
                                        Content="Open Folder"
                                        FontSize="12"
                                        Padding="10,4"
                                        Visibility="{x:Bind ShowOpenFolder}"
                                        Tag="{x:Bind OutputPath}"
                                        Click="OpenFolderButton_Click" />
                                    <TextBlock
                                        Grid.Column="3"
                                        Text="{x:Bind ErrorMessage}"
                                        Style="{ThemeResource SecondaryTextStyle}"
                                        FontSize="12"
                                        Foreground="{ThemeResource BrushError}"
                                        TextWrapping="Wrap"
                                        VerticalAlignment="Center"
                                        Margin="4,0,0,0" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock
                x:Name="EmptyStateText"
                Style="{ThemeResource SecondaryTextStyle}"
                Text="No conversion jobs yet. Use &quot;Convert…&quot; or &quot;Export Clip…&quot; in the player's overflow menu to add one."
                TextWrapping="Wrap"
                Visibility="Collapsed" />
        </StackPanel>
    </ScrollViewer>
</Page>