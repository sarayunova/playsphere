<Page
    x:Class="PlaySphere.UI.Pages.PlaylistsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource BrushBackgroundPrimary}"
    Loaded="Page_Loaded">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="28" Spacing="{ThemeResource SpacingMedium}">
            <TextBlock Style="{ThemeResource PageTitleTextStyle}" Text="Playlists" />
            <TextBlock
                Style="{ThemeResource SecondaryTextStyle}"
                Text="Build ordered play queues. Select a playlist to view, reorder and play its items."
                TextWrapping="Wrap" />

            <!-- Create / Add toolbar -->
            <StackPanel Spacing="12">
                <TextBlock Style="{ThemeResource SectionHeaderTextStyle}" Text="Create" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="NewPlaylistNameBox"
                        PlaceholderText="Playlist name"
                        KeyDown="NewPlaylistNameBox_KeyDown" />
                    <Button
                        x:Name="CreatePlaylistButton"
                        Grid.Column="1"
                        Content="Create Playlist"
                        Click="CreatePlaylistButton_Click" />
                </Grid>
                <Button
                    x:Name="ImportM3uButton"
                    HorizontalAlignment="Left"
                    Content="Import M3U / M3U8…"
                    Click="ImportM3uButton_Click" />
            </StackPanel>

            <!-- Two-pane: playlist list (left) + selected playlist detail (right) -->
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Playlist list -->
                <StackPanel Grid.Column="0" Spacing="8">
                    <TextBlock Style="{ThemeResource SectionHeaderTextStyle}" Text="Your playlists" />
                    <ListView
                        x:Name="PlaylistList"
                        SelectionChanged="PlaylistList_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="4,6" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        Glyph="&#xE8FD;"
                                        FontSize="16"
                                        Foreground="{ThemeResource BrushAccentBlue}"
                                        VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="1">
                                        <TextBlock
                                            Text="{Binding DisplayName}"
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            TextTrimming="CharacterEllipsis"
                                            Foreground="{ThemeResource BrushTextPrimary}" />
                                        <TextBlock
                                            Text="{Binding Subtitle}"
                                            FontSize="11"
                                            Foreground="{ThemeResource BrushTextMuted}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Border
                        x:Name="PlaylistsEmptyCard"
                        Style="{ThemeResource EmptyStateCardStyle}"
                        Visibility="Collapsed">
                        <TextBlock
                            Style="{ThemeResource MutedTextStyle}"
                            Text="No playlists yet. Create one above."
                            TextWrapping="Wrap" />
                    </Border>
                </StackPanel>

                <!-- Selected playlist detail -->
                <StackPanel Grid.Column="1" Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock
                                x:Name="DetailTitle"
                                Style="{ThemeResource SectionHeaderTextStyle}"
                                Text="Select a playlist" />
                            <TextBlock
                                x:Name="DetailCount"
                                Style="{ThemeResource MutedTextStyle}"
                                Text="Pick a playlist from the left to manage it."
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Button
                            x:Name="ExportPlaylistButton"
                            Grid.Column="1"
                            Content="Export M3U"
                            Margin="8,0,8,0"
                            IsEnabled="False"
                            Click="ExportPlaylistButton_Click" />
                        <Button
                            x:Name="RenamePlaylistButton"
                            Grid.Column="2"
                            Content="Rename"
                            Margin="0,0,8,0"
                            IsEnabled="False"
                            Click="RenamePlaylistButton_Click" />
                        <Button
                            x:Name="DeletePlaylistButton"
                            Grid.Column="3"
                            Content="Delete"
                            Margin="0,0,8,0"
                            IsEnabled="False"
                            Click="DeletePlaylistButton_Click" />
                        <Button
                            x:Name="PlayPlaylistButton"
                            Grid.Column="4"
                            Content="Play All"
                            IsEnabled="False"
                            Click="PlayPlaylistButton_Click" />
                    </Grid>

                    <!-- Add item to selected playlist -->
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox
                            x:Name="AddItemComboBox"
                            PlaceholderText="Add a library item…"
                            HorizontalAlignment="Stretch" />
                        <Button
                            x:Name="AddItemButton"
                            Grid.Column="1"
                            Content="Add"
                            IsEnabled="False"
                            Click="AddItemButton_Click" />
                    </Grid>

                    <!-- Items in the selected playlist -->
                    <StackPanel x:Name="ItemsPanel" Spacing="6" />
                    <Border
                        x:Name="ItemsEmptyCard"
                        Style="{ThemeResource EmptyStateCardStyle}"
                        Visibility="Collapsed">
                        <TextBlock
                            Style="{ThemeResource MutedTextStyle}"
                            Text="This playlist has no items yet. Add one from the dropdown above."
                            TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>

</Page>
