<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>PlaySphere.Audio</RootNamespace>
    <UseWinUI>false</UseWinUI>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Description>Windows-only NAudio WASAPI capture for the visualizer: feeds the app's own rendered audio to IVisualizerAudioSource (ADR-0009). Engine and visualizer modules stay plain net10.0.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PlaySphere.Application\PlaySphere.Application.csproj" />
    <ProjectReference Include="..\PlaySphere.Visualizer\PlaySphere.Visualizer.csproj" />
    <ProjectReference Include="..\PlaySphere.Media.Export\PlaySphere.Media.Export.csproj" />
  </ItemGroup>

</Project>
